// Cloudflare Worker: serves the web app (static assets from ../web/dist) and the JSON API under /lau-meme/api/*.
// The game lives under a sub-path of dinoduct.fun (ADR 0007): BASE_PATH must equal base-path.json and the route
// patterns below use it too (AC-SUBPATH-01 checks both). Only this game's path, its admin host and the host's robots.txt
// are declared - never dinoduct.fun/*.
// Top level = PRODUCTION (`wrangler deploy` without --env). Agents may only use --env staging; the dk guard
// blocks the rest. database_id values are not secrets - fill them from `npx wrangler d1 create <name>`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lau-meme",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // workers.dev stays on: deploy-cf.sh health-checks the workers.dev URL.
  "workers_dev": true,
  // + the admin page's own origin (ADR 0008): same Worker, routed by host (ADMIN_HOST).
  "routes": [
    { "pattern": "dinoduct.fun/lau-meme*", "zone_name": "dinoduct.fun" },
    { "pattern": "laumeme-admin.dinoduct.fun/*", "zone_name": "dinoduct.fun" },
    // The domain root has no origin: Meta's bot needs a robots.txt (AC-SUBPATH-15). Moves to the hub once there is one.
    { "pattern": "dinoduct.fun/robots.txt", "zone_name": "dinoduct.fun" }
  ],
  // The Worker answers first (prefix check, redirect, API, SPA fallback under the sub-path - the assets'
  // single-page-application mode only falls back to the root /index.html). Hashed build files skip it.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/lau-meme/assets/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lau-meme-prod", "database_id": "2a7d5380-5568-4981-9de2-8c39c551cd57", "migrations_dir": "migrations" }
  ],
  // Illustration images (ART, phase 2), served via /lau-meme/img/* - never public. Not inherited by env.staging.
  "r2_buckets": [{ "binding": "IMG", "bucket_name": "lau-meme-img" }],
  // mQuiz rooms (ADR 0021): one SQLite-backed Durable Object per room. Bindings are not inherited by env.staging or
  // previews, so both declare it again; the class migration is top level only.
  "durable_objects": { "bindings": [{ "name": "QUIZ_ROOM", "class_name": "QuizRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuizRoom"] }],
  // Daily retention job 03:00 GMT+7 (ADR 0004, AC-PRIV-06). Not inherited by env.staging: declared there too.
  "triggers": { "crons": ["0 20 * * *"] },
  "vars": { "APP_ENV": "production", "POLICY_VERSION": "1", "BASE_PATH": "/lau-meme", "ADMIN_HOST": "laumeme-admin.dinoduct.fun", "GOOGLE_CLIENT_ID": "983893414114-5s71asl52rc0c5o5pffdnbfa1n0uc2r1.apps.googleusercontent.com" },
  // Worker Previews (`wrangler preview`, run by Workers Builds on non-production branches). Bindings are not
  // inherited, so previews point at the STAGING data - never at production. No ADMIN_HOST: the admin page stays off.
  // Preview secrets are separate: `wrangler preview secret`.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "lau-meme-staging", "database_id": "03517712-b21e-427d-8881-53e34bf6c44b", "migrations_dir": "migrations" }
    ],
    "r2_buckets": [{ "binding": "IMG", "bucket_name": "lau-meme-img-staging" }],
    "durable_objects": { "bindings": [{ "name": "QUIZ_ROOM", "class_name": "QuizRoom" }] },
    "vars": { "APP_ENV": "preview", "POLICY_VERSION": "1", "BASE_PATH": "/lau-meme", "GOOGLE_CLIENT_ID": "983893414114-4fqirgtmr60j2ae9mumhtuuthr31vl4c.apps.googleusercontent.com" }
  },
  "env": {
    "staging": {
      "name": "lau-meme-staging",
      "routes": [
        { "pattern": "staging.dinoduct.fun/lau-meme*", "zone_name": "dinoduct.fun" },
        { "pattern": "laumeme-admin-staging.dinoduct.fun/*", "zone_name": "dinoduct.fun" },
        { "pattern": "staging.dinoduct.fun/robots.txt", "zone_name": "dinoduct.fun" }
      ],
      "d1_databases": [
        { "binding": "DB", "database_name": "lau-meme-staging", "database_id": "03517712-b21e-427d-8881-53e34bf6c44b", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "IMG", "bucket_name": "lau-meme-img-staging" }],
      "durable_objects": { "bindings": [{ "name": "QUIZ_ROOM", "class_name": "QuizRoom" }] },
      "triggers": { "crons": ["0 20 * * *"] },
      "vars": { "APP_ENV": "staging", "POLICY_VERSION": "1", "BASE_PATH": "/lau-meme", "ADMIN_HOST": "laumeme-admin-staging.dinoduct.fun", "GOOGLE_CLIENT_ID": "983893414114-4fqirgtmr60j2ae9mumhtuuthr31vl4c.apps.googleusercontent.com" }
    }
  }
}
