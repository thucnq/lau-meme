%% C4 container - Lẩu Meme (giai đoạn 1; nét đứt = giai đoạn 2)
flowchart LR
  player(["Thực khách<br/>(trình duyệt, UUID ẩn danh;<br/>đăng nhập Google tùy chọn)"])
  admin(["Quản trị<br/>(token)"])

  subgraph cf["Cloudflare (gói free) - zone dinoduct.fun, chung origin với các game khác (ADR 0007)"]
    redirect["Redirect Rule (người cấu hình)<br/>dinoduct.fun/ → 302 /lau-meme/"]
    worker["Worker lau-meme<br/>route dinoduct.fun/lau-meme*<br/>(staging: staging.dinoduct.fun/lau-meme*)<br/>web tĩnh + /lau-meme/api/* + Cron dọn dữ liệu<br/>route laumeme-admin.dinoduct.fun/* (ADMIN_HOST, ADR 0008)<br/>trang quản trị + /api/admin/*"]
    web["Web React + Vite<br/>static assets web/dist/lau-meme<br/>tra + giải mã graph trong bộ nhớ"]
    d1[("D1 (SQLite)<br/>nội dung 14 version, chặn, tier,<br/>người chơi, tài khoản, phiên,<br/>đề xuất meme, sự kiện, audit")]
    cache[("Cache API<br/>graph, ảnh bất biến")]
    wa["Web Analytics<br/>(không cookie)"]
    r2[("R2 ảnh<br/>(giai đoạn 2)")]
    wai["Workers AI<br/>(giai đoạn 2)"]
  end

  subgraph gh["GitHub"]
    actions["Pipeline Python<br/>GitHub Actions cron 05:00/17:00 UTC (staging mỗi 2 tiếng) + chạy tay"]
    issues["GitHub Issues<br/>báo cáo đợt"]
    secrets["GitHub Secrets<br/>PIPELINE_TOKEN, BANNED_WORDS,<br/>GEMINI_API_KEY, WORKERS_AI_TOKEN,<br/>THREADS_ACCESS_TOKEN"]
  end

  google["Google Identity Services<br/>ID token + JWKS (ADR 0010)"]
  %% TODO(doc): Threads API và THREADS_ACCESS_TOKEN (AC-PIPE-17) chưa có trong pipeline/src hay batch.yml; giữ trên sơ đồ theo thiết kế, xác nhận khi adapter được triển khai.
  sources["Nguồn meme công khai<br/>Reddit, KYM, Trends, YouTube, RSS,<br/>Tuổi Trẻ, Threads API (giai đoạn 2)"]
  gemini["Gemini API<br/>(giai đoạn 2, chỉ dữ liệu meme)"]

  player -- "HTTPS dinoduct.fun/" --> redirect
  player -- "HTTPS /lau-meme/: trang, manifest, graph, api" --> worker
  admin -- "HTTPS laumeme-admin.dinoduct.fun/ (origin riêng), Bearer ADMIN_TOKEN" --> worker
  worker -- "phục vụ" --> web
  worker -- "prepare().bind()" --> d1
  worker --> cache
  player -. beacon .-> wa
  player -- "nút đăng nhập, nhận ID token" --> google
  worker -- "kiểm ID token theo JWKS (cache)" --> google
  actions -- "Bearer PIPELINE_TOKEN → /lau-meme/api/pipeline/*: đăng mẻ, rollback, từ cấm, số liệu;<br/>đọc tier + đề xuất đã duyệt (không nickname, ADR 0013)" --> worker
  actions --> issues
  secrets --> actions
  actions -.-> sources
  actions -.-> gemini
  actions -. "vẽ ảnh qua REST (ADR 0012)" .-> wai
  actions -. "PUT /pipeline/images/{key} (ADR 0012)" .-> worker
  worker -. "ghi ảnh đã kiểm, đọc /img/* (binding IMG)" .-> r2
